#!/usr/bin/env python3
# A stand-in for Muse's Instagram tool, shaped as its docs describe, for the selftest of
# `bin/psyche.py collect`. Logs each call to $FAKEIG_LOG; FAKE_429=<command> answers that one with a 429.
import sys, json, os
a = sys.argv[1:]; cmd = a[0]; opt = {a[i]: a[i+1] for i in range(1, len(a)-1) if a[i].startswith('--')}
log = open(os.environ['FAKEIG_LOG'], 'a'); log.write('M ' + ' '.join(a) + '\n'); log.close()
if cmd == 'accounts':
    print(json.dumps({'accounts': [{'username': 'mei.t', 'user_fbid': 'ACC1', 'connected': True}, {'username': 'mei.shop', 'user_fbid': 'BIZ1', 'connected': False},
                                   {'username': 'mei.alt', 'user_fbid': 'ALT1', 'connected': False}], '_meta': {'fbids': ['ACC1', 'BIZ1', 'ALT1']}})); sys.exit(0)
if os.environ.get('FAKE_429') == cmd: print('HTTP 429 Too Many Requests', file=sys.stderr); sys.exit(1)
if cmd == 'thread' and int(opt.get('--first', '0')) > int(os.environ.get('FAKE_MAX_FIRST', '1000')): print('first must be at most ' + os.environ['FAKE_MAX_FIRST'], file=sys.stderr); sys.exit(2)
ME = opt.get('--account-id')
if cmd == 'top-recipients':
    th = [{'score_map_key': 'k%d' % i, 'thread_fbid': 'T%d' % i, 'thread_title': 'Friend %d' % i, 'thread_type': 'one_to_one',
           'users': [{'full_name': ['Kai Ng', 'Ana Cruz', 'Jun Lee'][i], 'id': 'U%d' % i, 'username': 'u%d' % i, 'score_map_key': 'k%d' % i}]} for i in range(3)]
    print(json.dumps({'entities': {'thread': th, 'user': []}, 'ranking': [{'view_name': 'x', 'score_map': [{'entity_type': 'thread', 'key': 'k%d' % i, 'score': [5, 9, 1][i]} for i in range(3)]}],
                      'has_next_page': False, 'page_max_id': 'P', 'status': 'ok'}))
elif cmd == 'thread':
    tid = opt['--thread-fbid']; i = int(tid[1:]); page = int(opt.get('--after', '0'))
    msgs = []
    for j in range(6):
        mine = j % 2 == 0
        msgs.append({'content': {'text_body': ('%s, are we still on for the run on Saturday? %s %d.%d' % (['Kai', 'Ana', 'Jun'][i], tid, page, j)) if mine else ('Yes! See you at 7, Mei %s %d.%d' % (tid, page, j))},
                     'content_type': 'text', 'message_id': 'mid', 'message_sent_at': {'utc': '2025-0%d-1%dT12:%02d:00Z' % (1 + page, j // 2, 5 * (j % 2)), 'user_local': '2025-0%d-1%d 20:%02d:00' % (1 + page, j // 2, 5 * (j % 2)), 'user_timezone': 'Asia/Singapore'},
                     'sender_fbid': ME if mine else 'U%d' % i, 'timestamp': '1736000000000'})
    print(json.dumps({'is_group': False, 'messages': msgs, 'messages_page_info': {'end_cursor': str(page + 1), 'has_next_page': page < (11 if tid == 'T2' else 1)},
                      'thread_fbid': tid, 'users': [{'full_name': ['Kai Ng', 'Ana Cruz', 'Jun Lee'][i], 'id': 'U%d' % i, 'interop_messaging_user_fbid': 'I%d' % i, 'username': 'u%d' % i}]}))
else:
    print('unknown', file=sys.stderr); sys.exit(3)
