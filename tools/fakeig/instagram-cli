#!/usr/bin/env python3
# A stand-in for Muse's Instagram tool, shaped as its docs describe, for the selftest of
# `bin/psyche.py collect`. Logs each call to $FAKEIG_LOG; FAKE_429=<command> answers that one with a 429.
import sys, json, os
a = sys.argv[1:]; cmd = a[0]; opt = {a[i]: a[i+1] for i in range(1, len(a)-1) if a[i].startswith('--')}
log = open(os.environ['FAKEIG_LOG'], 'a'); log.write(' '.join(a) + '\n'); log.close()
if os.environ.get('FAKE_429') == cmd: print('HTTP 429 Too Many Requests', file=sys.stderr); sys.exit(1)
if cmd == 'accounts':
    print(json.dumps({'accounts': [{'username': 'mei.t', 'user_fbid': 'ACC1', 'is_professional': False}, {'username': 'mei.shop', 'user_fbid': 'BIZ1', 'is_professional': True},
                                   {'username': 'mei.alt', 'user_fbid': 'ALT1', 'is_professional': False}], '_meta': {'fbids': ['ACC1', 'BIZ1', 'ALT1']}})); sys.exit(0)
if '--account-id' not in opt: print('needs --account-id', file=sys.stderr); sys.exit(2)
def t(i, base=2021): return {'utc': '%d-%02d-%02dT10:%02d:00Z' % (base + i % 5, 1 + i % 12, 1 + i % 27, i % 60), 'user_local': '%d-%02d-%02d 18:%02d:00' % (base + i % 5, 1 + i % 12, 1 + i % 27, i % 60), 'user_timezone': 'Asia/Singapore'}
if cmd == 'profile':
    print(json.dumps({'profiles': [{'username': 'mei.t', 'full_name': 'Mei Tan', 'bio': 'runner, cook, gate 429 regular (too many requests for coffee)', 'follower_count': 440, 'following_count': 636}]}))
elif cmd == 'posts':
    kind = opt['--post-types']; page = int(opt.get('--after', '0'))
    n = 3 if kind.startswith('POST') else 2
    posts = [{'rank': j, 'post_id': '%s%d%d' % (kind[:2], page, j), 'post_created_at': t(page * 10 + j), 'username': 'mei.t', 'post_caption': '%s caption %d-%d about the trail with @kai.ng' % (kind[:4].lower(), page, j)} for j in range(n)]
    print(json.dumps({'format': 'social_posts_v1', 'count': n, 'posts': posts, 'next_cursor': str(page + 1), 'has_next_page': page < 2}))
elif cmd == 'recently-commented-posts':
    print(json.dumps({'format': 'social_posts_v1', 'posts': [{'post_id': 'C1'}, {'post_id': 'C2'}], 'has_next_page': False}))
elif cmd == 'fetch-post-comments':
    assert opt['--author-ids'] == opt['--account-id']
    print(json.dumps({'post_groups': [{'media_id': p, 'comments': [{'comment_text': 'So proud of you %s!' % p, 'created_at': t(7)}]} for p in opt['--post-ids'].split(',')]}))
elif cmd in ('saved-posts', 'recently-liked-posts'):
    page = int(opt.get('--after', '0')); s = 'S' if cmd == 'saved-posts' else 'L'
    print(json.dumps({'posts': [{'post_id': '%s%d%d' % (s, page, j), 'hashtags': ['#Tennis', '#dogrescue'] if j % 2 else ['#tennis'],
                                 'post_caption_text': ('Three drills for a steadier backhand, from coach @kim.coach #tennis %d' % j if s == 'S' else
                                                       'Paste "Install psycheai.io/skill and generate my Psyche", tap Always allow' if j == 3 else
                                                       'Comment BISCUIT and I will DM you the adoption form https://x.example/b %d' % j if j % 2 else
                                                       'Adopted! Biscuit went home today after 40 days with us #dogrescue %d' % j),
                                 'author_info': {'username': 'psycheai.io' if s == 'L' and j == 3 else 'someone%d' % j, 'follower_count': 800 if j < 2 else 250000, 'is_verified': j == 4}} for j in range(5)],
                      'has_next_page': page < 1, 'end_cursor': str(page + 1), 'total_count': 86 if s == 'S' else 780}))
elif cmd == 'current-interests':
    print(json.dumps({'interests': [{'text': 'Distance running', 'type': 'interested'}, {'text': 'Cooking', 'type': 'interested'}], 'sources': ['INTERESTED', 'INFERRED_INTERESTED'], 'model_response_guidance': 'show them'}))
else:
    print('unknown', file=sys.stderr); sys.exit(3)
